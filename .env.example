# Copia este archivo a .env y rellena las claves.
# .env esta en .gitignore: NUNCA lo subas al repo.
# Pon limite de gasto duro en cada consola antes de usar la clave (regla 04).

# --- Claves de los proveedores (D0.2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Modelos por defecto (verificados el 5 sep 2026; comprueba antes de cada fase) ---
# Elegidos por baratos, no por buenos. Para experimentar no hace falta mas.
ANTHROPIC_MODELO=claude-haiku-4-5-20251001
OPENAI_MODELO=gpt-5-nano
GEMINI_MODELO=gemini-3.5-flash-lite
GROQ_MODELO=openai/gpt-oss-20b
# OpenRouter: opcional. Una sola clave para cientos de modelos, protocolo OpenAI.
# Los modelos con sufijo :free no cuestan nada (limite diario bajo sin creditos).
# Catalogo: https://openrouter.ai/models
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_MODELO=
OLLAMA_MODELO=llama3.2:3b

# --- Local (Ollama, sin clave) ---
OLLAMA_BASE_URL=http://localhost:11434/v1

# --- Presupuesto y guardas (regla 04) ---
PRESUPUESTO_USD_MES=10
MAX_STEPS=8
MAX_TOKENS_POR_TAREA=50000

# --- Red del trabajo: proxy con inspeccion TLS (ver notas/entorno.md) ---
# Si httpx o los SDK fallan con certificado desconocido, exporta la ruta al
# certificado raiz corporativo aqui.
# SSL_CERT_FILE=/Users/Jutavarez/.certs/corporativo.pem
