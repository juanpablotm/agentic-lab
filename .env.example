# Copia este archivo a .env y rellena las claves.
# .env esta en .gitignore: NUNCA lo subas al repo.
# Pon limite de gasto duro en cada consola antes de usar la clave (regla 04).

# --- Proveedores de modelos (D0.2) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# --- Local (Ollama, sin clave) ---
OLLAMA_BASE_URL=http://localhost:11434

# --- Presupuesto y guardas (regla 04) ---
PRESUPUESTO_USD_MES=10
MAX_STEPS=8
MAX_TOKENS_POR_TAREA=50000
